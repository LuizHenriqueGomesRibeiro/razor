{
   "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
   "variables": [
      { "name": "solutionPath", "value": "razor.sln" }
   ],
   "tasks": [
      {
         "name": "run-e2e",
         "group": "test",
         "command": "dotnet",
         "args": ["test", "razor.Tests.E2E/razor.Tests.E2E.csproj"],
         "states": ["pre-push"]
      }
   ]
}
