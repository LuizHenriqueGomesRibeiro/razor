{
   "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
   "tasks": [
      {
         "name": "welcome-message-example",
         "command": "bash",
         "args": [ "-c", "echo Husky.Net is awesome!" ],
         "windows": {
            "command": "cmd",
            "args": ["/c", "echo Husky.Net is awesome!" ]
         }
      },
      {
         "name": "verificar-formatacao",
         "group": "pre-commit",
         "command": "dotnet",
         "args": ["format", "--verify-no-changes"],
         "include": ["**/*.cs", "**/*.cshtml"]
      }
   ]
}
